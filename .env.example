# DevPlane Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit secrets to version control

# =============================================
# BITWARDEN VAULT CONFIGURATION
# =============================================
# Master password for Bitwarden vault (or use API key below)
# BITWARDEN_MASTER_PASSWORD=your_master_password

# Bitwarden API key authentication
# BITWARDEN_CLIENT_ID=your_client_id
# BITWARDEN_CLIENT_SECRET=your_client_secret
# BITWARDEN_ORG_ID=your_org_id

# =============================================
# SSO / OAUTH CONFIGURATION
# =============================================
# Default SSO provider (google, github, microsoft, oidc)
# SSO_PROVIDER=google

# Google OAuth
# SSO_GOOGLE_CLIENT_ID=your_google_client_id
# SSO_GOOGLE_CLIENT_SECRET=your_google_client_secret
# SSO_REDIRECT_URI=https://yourdomain.com/api/auth/callback

# GitHub OAuth
# SSO_GITHUB_CLIENT_ID=your_github_client_id
# SSO_GITHUB_CLIENT_SECRET=your_github_client_secret

# Microsoft Azure AD
# SSO_MICROSOFT_CLIENT_ID=your_microsoft_client_id
# SSO_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# SSO_MICROSOFT_TENANT_ID=your_tenant_id

# Generic OIDC
# SSO_OIDC_ISSUER_URL=https://your-oidc-provider.com

# =============================================
# JWT CONFIGURATION
# =============================================
# Secret key for JWT signing (use a strong random string)
# JWT_SECRET=your_strong_random_secret_key_min_32_chars
# JWT_ISSUER=devplane
# JWT_AUDIENCE=devplane

# For RS256, use actual key files
# JWT_PRIVATE_KEY_PATH=/path/to/private.key
# JWT_PUBLIC_KEY_PATH=/path/to/public.key

# =============================================
# API KEYS (for production, use Bitwarden)
# =============================================
# These should be stored in Bitwarden, not here
# OPENROUTER_API_KEY=
# TOGETHERAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# =============================================
# DATABASE CONFIGURATION
# =============================================
# DATABASE_URL=sqlite+aiosqlite:///./devplane.db

# =============================================
# DIGITALOCEAN CONFIGURATION
# =============================================
# DO_API_TOKEN=your_digitalocean_token
# DO_SSH_KEY_ID=your_ssh_key_id

# =============================================
# CLOUDFLARE CONFIGURATION
# =============================================
# CLOUDFLARE_API_TOKEN=your_cloudflare_token
# CLOUDFLARE_API_EMAIL=your_email@example.com

# =============================================
# TWILIO (for SMS MFA)
# =============================================
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890

# =============================================
# SANDBOX SECURITY
# =============================================
# Sandbox SSH key (auto-generated if not set)
# SANDBOX_SSH_KEY_NAME=deployment
