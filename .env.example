# ═══════════════════════════════════════════════════════════════════════════════
# DevPlane Production Configuration
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────────
ENV=production
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ─── Server Configuration ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEVPLANE_DB_PATH=./devplane.db

# ─── Slack Integration ────────────────────────────────────────────────────────
# Get these from https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# ─── AI Provider API Keys ─────────────────────────────────────────────────────
# Configure at least one provider. More providers = better failover.

# OpenRouter - Access to multiple models via single API
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# DeepSeek - Free tier available
# Get key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# Groq - Free tier available (fast inference)
# Get key: https://console.groq.com/
GROQ_API_KEY=gsk_...

# Google Gemini - Free tier available
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# Cerebras - Free tier available
# Get key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-...

# Together AI - Various open models
# Get key: https://api.together.xyz/settings/api-keys
TOGETHERAI_API_KEY=...

# Fireworks AI - Fast inference
# Get key: https://app.fireworks.ai/
FIREWORKS_AI_API_KEY=...

# OpenAI - GPT models (paid)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Vector Database (Qdrant) ─────────────────────────────────────────────────
# Optional but recommended for semantic memory search
# Use Qdrant Cloud (https://cloud.qdrant.io/) or self-host
QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_KEY=your-qdrant-api-key

# ─── Infrastructure (DigitalOcean) ────────────────────────────────────────────
# Required for VM/GPU provisioning
# Get token: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=dop_v1_...
DIGITALOCEAN_REGION=nyc1
DIGITALOCEAN_VPC_ID=your-vpc-uuid  # Optional
DIGITALOCEAN_SSH_KEY_ID=12345678   # Optional: ID of SSH key to add to droplets

# ─── Cloudflare (DNS & Tunnels) ───────────────────────────────────────────────
# Required for automatic DNS management and secure tunnels
# Get API key: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_KEY=your-global-api-key
CLOUDFLARE_EMAIL=your-email@example.com
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_DOMAIN=yourdomain.com

# For Cloudflare Tunnel (secure ingress without opening ports)
# Create tunnel: cloudflared tunnel create devplane
TUNNEL_TOKEN=eyJh...

# ─── GPU Compute Providers (Optional) ─────────────────────────────────────────
# Vast.ai - Cheapest GPU spot instances
# Get key: https://vast.ai/console/account/
VAST_API_KEY=...

# RunPod - Serverless GPU
# Get key: https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=...

# Modal - Burst compute
# Get key: https://modal.com/settings/tokens
MODAL_TOKEN_ID=...
MODAL_TOKEN_SECRET=...

# Lambda Labs - Cloud GPUs
# Get key: https://cloud.lambdalabs.com/api-keys
LAMBDA_API_KEY=...

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-for-session-signing

# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# ─── Multi-Factor Authentication (MFA) ────────────────────────────────────────
# TOTP Issuer Name (shown in authenticator apps)
TOTP_ISSUER=DevPlane

# SMS-based MFA (Twilio)
# Get credentials: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# WebAuthn/FIDO2 Configuration
# Relying Party ID (must match your domain)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DevPlane

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Sentry for error tracking (optional)
SENTRY_DSN=https://...@sentry.io/...

# ─── Database (PostgreSQL - Optional) ─────────────────────────────────────────
# Only needed if using PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:pass@localhost/devplane

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_SLACK=false
ENABLE_GPU_PROVIDERS=false
ENABLE_CLOUDFLARE_TUNNEL=false
